# Copy to .env and fill in the two keys. Everything else has a working default
# (app/core/config.py); uncomment a line only to change it.

# --- Required
GEMINI_API_KEY=            # https://aistudio.google.com/apikey (free tier)
COHERE_API_KEY=            # https://dashboard.cohere.com (trial key: ~1,000 reranks a month)

# --- Optional: LangSmith traces of every node, prompt, token count and latency
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=bank-policy-assistant

# --- Storage (docker-compose.yml sets these for the containers)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bankpolicy
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=policy_chunks

# --- Models per role ("<provider>:<model>", LangChain init_chat_model); each role has a fallback
# PLANNER_MODEL=google_genai:gemini-3.1-flash-lite
# REVIEWER_MODEL=google_genai:gemini-3.1-flash-lite
# GENERATOR_MODEL=google_genai:gemini-3.5-flash-lite
# JUDGE_MODEL=google_genai:gemini-3.1-flash-lite
# PLANNER_FALLBACK_MODEL=google_genai:gemini-3.5-flash-lite
# REVIEWER_FALLBACK_MODEL=google_genai:gemini-3.5-flash-lite
# GENERATOR_FALLBACK_MODEL=google_genai:gemini-3.1-flash-lite
# JUDGE_FALLBACK_MODEL=google_genai:gemini-3.5-flash-lite
# JUDGE_CROSS_CHECK_MODEL=google_genai:gemini-3.8-flash
# PLANNER_THINKING_LEVEL=low
# REVIEWER_THINKING_LEVEL=low
# GENERATOR_THINKING_LEVEL=medium
# JUDGE_THINKING_LEVEL=low
# STRUCTURED_OUTPUT_METHOD=json_schema
# LLM_REQUESTS_PER_MINUTE=15
# LLM_TIMEOUT_S=20

# --- Retrieval (embeddings are fixed: changing them means re-indexing everything)
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# RETRIEVAL_CANDIDATES=30
# RRF_K=60
# RERANK_MODEL=rerank-v4.0-pro
# RERANK_TOP_N=5
# RERANK_CALLS_PER_MINUTE=10
# DEFAULT_SECTOR=banking

# --- Streamlit UI
# API_URL=http://localhost:8000
# PUBLIC_API_URL=http://localhost:8000

# LOG_LEVEL=INFO
