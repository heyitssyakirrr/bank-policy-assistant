{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(python -m ruff *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(alembic *)",
      "Bash(python -m alembic *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git tag *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose up *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose build *)",
      "Bash(docker compose stop *)"
    ],
    "ask": [
      "Bash(python -m app.ingestion.indexer *)",
      "Bash(python -m app.ingestion.pipeline *)",
      "Bash(python -m evals.run *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(docker compose down *)",
      "Bash(docker volume rm *)",
      "Bash(python -m app.ingestion.indexer --recreate *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/format_python.py"
          }
        ]
      }
    ]
  }
}
