__pycache__/
.venv/
*.pyc
.env

# Generated by the ingestion pipeline (rebuild with: python -m app.ingestion.pipeline).
# Two gzipped copies ARE committed so Docker can rebuild Qdrant with zero API calls:
# the chunks and the embedding cache (re-embedding takes two days on the free tier).
app/data/interim/*
!app/data/interim/embeddings/
app/data/interim/embeddings/*
!app/data/interim/embeddings/*.jsonl.gz
app/data/processed/*
!app/data/processed/chunks.jsonl.gz
app/data/debug/

# Secrets: any .env variant except the committed example
.env.*
!.env.example
scripts/_parser_trial/

.pytest_cache/
.ruff_cache/
